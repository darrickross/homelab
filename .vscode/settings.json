{
  // Workspace level holds only conventions specific to this repo.
  // Editor style + generic vocabulary live in User settings
  // (dotfiles-windows repo); WSL machine paths (ansible/python
  // interpreters, formatter binaries) live in
  // ~/.vscode-server/data/Machine/settings.json (deployed by the
  // dotfiles repo via home-manager).
  "cSpell.words": [
    "betapassword",
    "BOOTX",
    "certlm.msc",
    "certsrv.msc",
    "DTLSHandlerComponent",
    "ECDH_P",
    "FGDSIpNetDriver",
    "homelab",
    "HomeLab",
    "libpve",
    "pihole",
    "proxmoxlib",
    "pveproxy",
    "pveversion",
    "steamcmd",
    "Valheim",
    "vmbr"
  ],
  "files.associations": {
    "*plays.yml": "ansible",
    "*init.yml": "yaml"
  }
}
